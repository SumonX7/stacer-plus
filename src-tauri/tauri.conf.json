{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stacer Plus",
  "version": "1.2.1",
  "identifier": "com.spark.stacerplus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stacer Plus",
        "width": 980,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Modern Linux System Optimizer & Telemetry Monitor",
    "longDescription": "Stacer Plus is a modern, ultra-fast, and memory-safe Linux System Optimizer and Telemetry Monitor built with Rust and Tauri v2.",
    "category": "Utilities",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "release": "1",
        "postInstallScript": "../scripts/rpm-postinstall.sh",
        "files": {
          "/usr/bin/stacer-plus-clean-ram": "../scripts/stacer-plus-clean-ram",
          "/usr/share/polkit-1/actions/com.spark.stacerplus.policy": "../scripts/com.spark.stacerplus.policy",
          "/usr/share/polkit-1/rules.d/90-stacer-plus.rules": "../scripts/90-stacer-plus.rules",
          "/usr/share/icons/hicolor/scalable/apps/stacer-plus.svg": "icons/stacer-plus.svg"
        }
      }
    }
  }
}
